# ==============================================================================
# ARAA (Autonomous Research & Analysis Agent) - Environment Configuration
# ZERO-COST READY: Defaults to free tiers (Google Gemini / Groq / Ollama / DuckDuckGo)
# ==============================================================================

# Application Environment (local | staging | production)
APP_ENV=local
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Database & Vector Store (Local Docker Compose - 100% Free)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://araa_user:araa_password@localhost:5432/araa_db
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# LLM Providers (Zero-Cost Configuration)
# Choose one of: gemini | groq | ollama | openai
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Option A: Google AI Studio (Gemini Free Tier - $0)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
PLANNER_MODEL=gemini-flash-lite-latest
ACTOR_MODEL=gemini-flash-lite-latest
VERIFIER_MODEL=gemini-flash-lite-latest

# Option B: Groq Cloud (Free Tier - $0)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# PLANNER_MODEL=llama-3.3-70b-versatile
# ACTOR_MODEL=llama-3.3-70b-versatile

# Option C: Ollama Local Inference (100% Offline & Free - $0)
# Install from: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
# PLANNER_MODEL=llama3.1:8b
# ACTOR_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# Web Search Tool (Zero-Cost Configuration)
# Choose: duckduckgo (No key needed - $0) | tavily (1000 free/mo) | brave
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Autonomous Agent Guardrails & Budget Ceilings
# ------------------------------------------------------------------------------
MAX_STEPS_DEFAULT=25
MAX_COST_USD_DEFAULT=1.50
RUN_TIMEOUT_S=600

# ------------------------------------------------------------------------------
# Sandbox & Security
# ------------------------------------------------------------------------------
SANDBOX_IMAGE=python:3.12-slim
JWT_SECRET=generate-a-secure-random-secret-key-for-local-development

# ------------------------------------------------------------------------------
# Observability & Tracing (Self-hosted Langfuse via Docker - $0)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
